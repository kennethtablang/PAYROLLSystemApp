<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PAYROLLSystemApp.ViewModels"
             xmlns:models="clr-namespace:PAYROLLSystemApp.Models"
             x:Class="PAYROLLSystemApp.Views.Sections.PayslipsView"
             x:DataType="vm:PayslipsViewModel">

    <Grid Padding="20">

        <!-- FR-002: the section re-checks the permission on load. -->
        <Border Style="{StaticResource Card}"
                IsVisible="{Binding IsDenied}"
                Padding="28"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <VerticalStackLayout Spacing="4">
                <Label Style="{StaticResource SectionHeading}" Text="Access denied" HorizontalTextAlignment="Center" />
                <Label Style="{StaticResource Muted}" Text="You do not have permission to view payslips." />
            </VerticalStackLayout>
        </Border>

        <Grid IsVisible="{Binding IsGranted}" RowDefinitions="Auto,Auto,*" RowSpacing="10">

            <!-- ============ FILTERS ============ -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">

                <Label Grid.Column="0"
                       Style="{StaticResource FieldLabel}"
                       VerticalOptions="Center"
                       Text="YEAR" />

                <Border Grid.Column="1" Style="{StaticResource FieldFrame}">
                    <Picker ItemsSource="{Binding YearOptions}"
                            SelectedItem="{Binding SelectedYearOption}"
                            ItemDisplayBinding="{Binding Label, x:DataType=vm:LookupOption}"
                            WidthRequest="110" />
                </Border>

                <!-- FR-072: an employee sees only their own history, so the
                     filter is not offered to them at all. -->
                <Border Grid.Column="2"
                        Style="{StaticResource FieldFrame}"
                        IsVisible="{Binding CanSeeEveryone}">
                    <Picker ItemsSource="{Binding EmployeeOptions}"
                            SelectedItem="{Binding SelectedEmployee}"
                            ItemDisplayBinding="{Binding Label, x:DataType=vm:LookupOption}"
                            WidthRequest="220" />
                </Border>

                <Label Grid.Column="3"
                       Style="{StaticResource Faint}"
                       VerticalOptions="Center"
                       Padding="8,0"
                       LineBreakMode="TailTruncation"
                       Text="{Binding Summary}" />

                <Button Grid.Column="4"
                        Style="{StaticResource SecondaryButton}"
                        Text="Refresh"
                        VerticalOptions="Center"
                        Command="{Binding RefreshCommand}" />
            </Grid>

            <!-- Inline result banner (NFR-023) -->
            <Label Grid.Row="1"
                   FontSize="12"
                   TextColor="{StaticResource Success}"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatus}" />

            <Label Grid.Row="1"
                   Style="{StaticResource ErrorText}"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}" />

            <Border Grid.Row="2"
                    Style="{StaticResource Card}"
                    Padding="28"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    IsVisible="{Binding HasNoPayslips}">
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource SectionHeading}"
                           Text="No payslips"
                           HorizontalTextAlignment="Center" />
                    <Label Style="{StaticResource Muted}"
                           HorizontalTextAlignment="Center"
                           Text="{Binding EmptyMessage}" />
                </VerticalStackLayout>
            </Border>

            <Grid Grid.Row="2"
                  ColumnDefinitions="330,*"
                  ColumnSpacing="14"
                  IsVisible="{Binding HasPayslips}">

                <!-- ============ HISTORY ============ -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <CollectionView ItemsSource="{Binding Payslips}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PayslipHistoryRow">
                                <Grid BackgroundColor="{Binding RowColor}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PayslipsViewModel}}, Path=SelectRowCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="16,10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label Text="{Binding PeriodDisplay}"
                                                   FontSize="12.5"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                            <Label Style="{StaticResource Faint}"
                                                   LineBreakMode="TailTruncation"
                                                   Text="{Binding Detail}" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="1"
                                               Style="{StaticResource Body}"
                                               VerticalOptions="Center"
                                               Text="{Binding NetDisplay}" />

                                        <BoxView Grid.ColumnSpan="2" VerticalOptions="End" Style="{StaticResource Divider}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <!-- ============ THE PAYSLIP ============ -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>

                        <VerticalStackLayout IsVisible="{Binding HasNoSelection}"
                                             Spacing="4"
                                             Padding="24"
                                             VerticalOptions="Center">
                            <Label Style="{StaticResource SectionHeading}"
                                   Text="No payslip selected"
                                   HorizontalTextAlignment="Center" />
                            <Label Style="{StaticResource Muted}"
                                   HorizontalTextAlignment="Center"
                                   Text="Pick a pay period on the left." />
                        </VerticalStackLayout>

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" IsVisible="{Binding HasSelection}">

                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="16,12">
                                <VerticalStackLayout Grid.Column="0" Spacing="1">
                                    <Label Style="{StaticResource SectionHeading}" Text="{Binding DetailTitle}" />
                                    <Label Style="{StaticResource Faint}"
                                           LineBreakMode="TailTruncation"
                                           Text="{Binding DetailSubtitle}" />
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Text="Export whole run"
                                            IsVisible="{Binding CanSeeEveryone}"
                                            Command="{Binding ExportRunCommand}" />
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Text="Export PDF"
                                            Command="{Binding ExportCommand}" />
                                </HorizontalStackLayout>
                            </Grid>

                            <Label Grid.Row="1"
                                   Style="{StaticResource Body}"
                                   Padding="16,0,16,10"
                                   Text="{Binding DetailTotals}" />

                            <!-- Where the file went, and a way to open it. -->
                            <Grid Grid.Row="2"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  Padding="16,0,16,10"
                                  IsVisible="{Binding HasExport}">
                                <Label Grid.Column="0"
                                       Style="{StaticResource Faint}"
                                       VerticalOptions="Center"
                                       LineBreakMode="MiddleTruncation"
                                       Text="{Binding ExportedPath}" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource RowAction}"
                                        Text="Open"
                                        Command="{Binding OpenExportCommand}" />
                            </Grid>

                            <Grid Grid.Row="3"
                                  ColumnDefinitions="*,120"
                                  ColumnSpacing="10"
                                  Padding="16,8"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}">
                                <Label Grid.Column="0" Style="{StaticResource TableHeader}" Text="ITEM" />
                                <Label Grid.Column="1" Style="{StaticResource TableHeader}" Text="AMOUNT" />
                            </Grid>

                            <CollectionView Grid.Row="4" ItemsSource="{Binding Lines}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PayslipLine">
                                        <Grid ColumnDefinitions="*,120" ColumnSpacing="10" Padding="16,7">

                                            <VerticalStackLayout Grid.Column="0" Spacing="0">
                                                <Label Text="{Binding Name}"
                                                       FontSize="12.5"
                                                       LineBreakMode="TailTruncation"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                                <Label Style="{StaticResource Faint}"
                                                       LineBreakMode="TailTruncation"
                                                       Text="{Binding BasisDisplay}" />
                                                <Label Style="{StaticResource Faint}"
                                                       LineBreakMode="WordWrap"
                                                       Text="{Binding Note}" />
                                            </VerticalStackLayout>

                                            <Label Grid.Column="1"
                                                   Style="{StaticResource Body}"
                                                   HorizontalTextAlignment="End"
                                                   VerticalOptions="Center"
                                                   Text="{Binding AmountDisplay}" />

                                            <BoxView Grid.ColumnSpan="2" VerticalOptions="End" Style="{StaticResource Divider}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- FR-074 -->
                            <VerticalStackLayout Grid.Row="5" Padding="16,10" Spacing="4"
                                                 BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}">
                                <Label Style="{StaticResource TableHeader}" Text="YEAR TO DATE" />
                                <Label Style="{StaticResource Body}" Text="{Binding YearToDateDisplay}" />
                                <Label Style="{StaticResource Faint}"
                                       IsVisible="{Binding HasEmployerShare}"
                                       Text="{Binding EmployerShareDisplay}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</ContentView>
