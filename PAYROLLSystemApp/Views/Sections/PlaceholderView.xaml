<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PAYROLLSystemApp.Views.Sections.PlaceholderView">

    <Grid Padding="20">
        <Border Style="{StaticResource Card}"
                Padding="28"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                MaximumWidthRequest="440">

            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">

                <Border WidthRequest="40"
                        HeightRequest="40"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoftLight}, Dark={StaticResource BrandSoftDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label Text="◷"
                           FontSize="18"
                           TextColor="{StaticResource Brand}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label x:Name="TitleLabel"
                       Style="{StaticResource PageTitle}"
                       FontSize="16"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="DescriptionLabel"
                       Style="{StaticResource Muted}"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="PlannedLabel"
                       Style="{StaticResource Faint}"
                       Margin="0,4,0,0"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentView>
