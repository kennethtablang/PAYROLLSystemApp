<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PAYROLLSystemApp.ViewModels"
             xmlns:models="clr-namespace:PAYROLLSystemApp.Models"
             x:Class="PAYROLLSystemApp.Views.Sections.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Style="{StaticResource PageTitle}" Text="{Binding Greeting}" />

            <!-- KPI row -->
            <FlexLayout BindableLayout.ItemsSource="{Binding Stats}"
                        Wrap="Wrap"
                        JustifyContent="Start"
                        AlignItems="Stretch">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatCard">
                        <Border Style="{StaticResource StatCard}"
                                WidthRequest="212"
                                Margin="0,0,12,12">
                            <VerticalStackLayout Spacing="3">
                                <Label Style="{StaticResource Faint}" Text="{Binding Caption}" />
                                <Label Text="{Binding Value}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                <Label Style="{StaticResource Faint}" Text="{Binding Detail}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- Two-column body -->
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="16" RowSpacing="16">

                <!-- Needs attention -->
                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="1">
                            <Label Style="{StaticResource SectionHeading}" Text="Needs attention" />
                            <Label Style="{StaticResource Faint}" Text="What is waiting on you in this payroll cycle" />
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource Divider}" />

                        <Label Style="{StaticResource Muted}"
                               IsVisible="{Binding IsAllClear}"
                               Text="Nothing needs attention right now." />

                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Attention}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AttentionItem">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="0,8">
                                        <Ellipse Grid.Column="0"
                                                 WidthRequest="8"
                                                 HeightRequest="8"
                                                 VerticalOptions="Center"
                                                 Fill="{AppThemeBinding Light=#1B4F87, Dark=#7FB2E5}">
                                            <Ellipse.Triggers>
                                                <DataTrigger TargetType="Ellipse" Binding="{Binding IsUrgent}" Value="True">
                                                    <Setter Property="Fill" Value="{AppThemeBinding Light=#B45309, Dark=#FBBF24}" />
                                                </DataTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>

                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label Text="{Binding Title}"
                                                   FontSize="12.5"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                            <Label Style="{StaticResource Faint}" Text="{Binding Detail}" />
                                        </VerticalStackLayout>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource SecondaryButton}"
                                                VerticalOptions="Center"
                                                Text="{Binding ActionText}"
                                                Command="{Binding GoCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Shortcuts -->
                <Border Grid.Column="1" Style="{StaticResource Card}" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="1">
                            <Label Style="{StaticResource SectionHeading}" Text="Quick actions" />
                            <Label Style="{StaticResource Faint}" Text="The screens your role uses most" />
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource Divider}" />

                        <FlexLayout Wrap="Wrap"
                                    JustifyContent="Start"
                                    BindableLayout.ItemsSource="{Binding QuickActions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:QuickAction">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,8"
                                            Text="{Binding Text}"
                                            Command="{Binding GoCommand}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Recent activity (administrators only) -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding ShowActivity}">
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout Spacing="1">
                        <Label Style="{StaticResource SectionHeading}" Text="Recent activity" />
                        <Label Style="{StaticResource Faint}" Text="Latest entries from the audit trail" />
                    </VerticalStackLayout>

                    <BoxView Style="{StaticResource Divider}" />

                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding RecentActivity}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:AuditEntry">
                                <Grid ColumnDefinitions="140,170,*" ColumnSpacing="12" Padding="0,5">
                                    <Label Grid.Column="0"
                                           Style="{StaticResource Faint}"
                                           Text="{Binding TimestampLocal, StringFormat='{0:dd MMM h:mm:ss tt}'}" />
                                    <Label Grid.Column="1"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           Text="{Binding Action}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                    <Label Grid.Column="2"
                                           Style="{StaticResource Muted}"
                                           LineBreakMode="TailTruncation"
                                           Text="{Binding Details}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
